generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(uuid())
  // Existing app fields (kept; username set from email on OAuth signup)
  username      String    @unique
  password      String?
  // Better Auth core user fields
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions   Session[]
  accounts   Account[]
  documents  Document[]
  chats      Chat[]
  projects   Project[]
  memories   Memory[]
  connectors Connector[]
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Memory {
  id         String    @id @default(uuid())
  fact       String
  importance Int       @default(5)
  /// chat | manual | connector
  source     String    @default("chat")
  chatId     String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastUsedAt DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, importance])
}

/// External knowledge connectors (GitHub, Notion-style URL, RSS, generic web).
model Connector {
  id           String    @id @default(uuid())
  /// github | rss | url | notion
  type         String
  name         String
  /// Provider-specific config (repo, feed URL, access token, etc.)
  config       Json      @default("{}")
  /// ACTIVE | PAUSED | ERROR
  status       String    @default("ACTIVE")
  lastSyncedAt DateTime?
  lastError    String?
  /// Minutes between continuous sync polls (default 30)
  syncInterval Int       @default(30)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs   ConnectorSyncJob[]

  @@index([userId])
  @@index([status, lastSyncedAt])
}

model ConnectorSyncJob {
  id               String    @id @default(uuid())
  /// PENDING | RUNNING | SUCCESS | FAILED
  status           String    @default("PENDING")
  documentsCreated Int       @default(0)
  error            String?
  startedAt        DateTime  @default(now())
  finishedAt       DateTime?

  connectorId String
  connector   Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@index([connectorId])
  @@index([status])
}

enum DocumentStatus {
  UPLOADED
  QUEUED
  PARSING
  PROCESSING
  PARSED
  EMBEDDING
  INDEXED
  COMPLETED
  READY
  FAILED
  RETRYING
}

model Document {
  id              String         @id @default(uuid())
  title           String
  content         String?
  mimeType        String         @default("application/pdf")
  modality        String         @default("pdf")
  ObjectKey       String         @unique
  status          DocumentStatus @default(UPLOADED)
  streamMessageId String?
  tags            String[]       @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  chunkSets ParsedChunkSet[]

  @@index([userId])
}

model ParsedChunkSet {
  id         String   @id @default(uuid())
  modality   String
  status     String   @default("PARSED")
  createdAt  DateTime @default(now())

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  chunks ParsedChunk[]

  @@index([documentId])
}

model ParsedChunk {
  id        String   @id @default(uuid())
  text      String
  metadata  Json?

  chunkSetId String
  chunkSet   ParsedChunkSet @relation(fields: [chunkSetId], references: [id], onDelete: Cascade)

  @@index([chunkSetId])
}

model Project {
  id           String   @id @default(uuid())
  name         String
  systemPrompt String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  chats  Chat[]

  @@index([userId])
}

model Chat {
  id        String   @id @default(uuid())
  title     String   @default("New chat")
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  summary   String?
  lastSummaryCount Int @default(0)

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([projectId])
}

model Message {
  id           String   @id @default(uuid())
  role         String
  content      String
  sourceChunks Json?
  createdAt    DateTime @default(now())

  chatId String
  chat   Chat   @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId])
}
